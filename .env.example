# Good Eco Solutions - Environment Variables Template for Hostinger / Production
# Copy these values into your Hostinger Environment Variables dashboard or server .env file

NODE_ENV=production
PORT=3000

# Authentication & Security (generate a strong random 64-character secret)
JWT_SECRET=your_super_strong_jwt_secret_minimum_32_characters_here

# Firebase Configuration (Admin SDK Credentials)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id

# SMS Gateway (Aquasms)
AQUASMS_USERNAME=your_aquasms_username
AQUASMS_API_KEY=your_aquasms_api_key
AQUASMS_SENDER_ID=your_sender_id
AQUASMS_PEID=your_peid
AQUASMS_TEMPLATE_ID=your_template_id
AQUASMS_MESSAGE_TEMPLATE="Dear {#var#}, your vehicle valuation request has been received. Team Good Eco Solutions."

# Hostinger Mail / SMTP (Optional if using transactional emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@goodecosolutions.in
SMTP_PASS=your_email_password

